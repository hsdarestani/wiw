{
  "expo": {
    "name": "SchichtPro",
    "slug": "schichtpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "schichtpro",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sbs.smarbiz.schichtpro",
      "buildNumber": "1",
      "infoPlist": { "NSLocationWhenInUseUsageDescription": "SchichtPro verwendet deinen Standort beim Einstempeln, um den Arbeitsort zu bestätigen." }
    },
    "android": {
      "package": "sbs.smarbiz.schichtpro",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#F5F6F7" }
    },
    "plugins": ["expo-router", "expo-notifications", ["expo-location", { "locationWhenInUsePermission": "SchichtPro verwendet deinen Standort beim Einstempeln, um den Arbeitsort zu bestätigen." }]],
    "extra": {
      "apiUrl": "https://schichtpro.smarbiz.sbs",
      "easProjectId": ""
    }
  }
}
