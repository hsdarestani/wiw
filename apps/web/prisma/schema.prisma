generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  industry          String?
  createdAt         DateTime           @default(now())
  users             User[]
  locations         Location[]
  invitations       Invitation[]
  positions         Position[]
  shifts            Shift[]
  timeOffRequests   TimeOffRequest[]
  availabilityRules AvailabilityRule[]
  shiftTrades       ShiftTrade[]
  timeEntries       TimeEntry[]
  auditLogs         AuditLog[]
  messages          Message[]
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  firstName         String
  lastName          String
  role              Role               @default(OWNER)
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions          Session[]
  shifts            Shift[]
  hourlyRate        Decimal            @default(0) @db.Decimal(10, 2)
  timeOffRequests   TimeOffRequest[]   @relation("Requester")
  reviewedTimeOff   TimeOffRequest[]   @relation("Reviewer")
  availabilityRules AvailabilityRule[]
  offeredTrades     ShiftTrade[]       @relation("TradeOwner")
  claimedTrades     ShiftTrade[]       @relation("TradeClaimant")
  reviewedTrades    ShiftTrade[]       @relation("TradeReviewer")
  timeEntries       TimeEntry[]
  auditLogs         AuditLog[]
  messages          Message[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Location {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  invitations    Invitation[]
  shifts         Shift[]
  timeEntries    TimeEntry[]
}

model Position {
  id             String       @id @default(cuid())
  name           String
  color          String       @default("#168b7e")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts         Shift[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model Shift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  positionId     String
  position       Position     @relation(fields: [positionId], references: [id], onDelete: Restrict)
  assigneeId     String?
  assignee       User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  startsAt       DateTime
  endsAt         DateTime
  unpaidBreakMin Int          @default(0)
  notes          String?
  status         ShiftStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tradeRequests  ShiftTrade[]

  @@index([organizationId, startsAt])
  @@index([assigneeId, startsAt])
}

model TimeOffRequest {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation("Requester", fields: [userId], references: [id], onDelete: Cascade)
  startsOn       DateTime      @db.Date
  endsOn         DateTime      @db.Date
  requestType    TimeOffType
  note           String?
  status         RequestStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?         @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status, startsOn])
  @@index([userId, startsOn])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  entityType     String
  entityId       String
  action         String
  reason         String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model AvailabilityRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday        Int
  startMinute    Int
  endMinute      Int
  available      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, weekday])
  @@index([userId, weekday])
}

model Invitation {
  id             String       @id @default(cuid())
  code           String       @unique
  email          String?
  role           Role         @default(EMPLOYEE)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ShiftTrade {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?            @relation("TradeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  claimantId     String?
  claimant       User?            @relation("TradeClaimant", fields: [claimantId], references: [id], onDelete: SetNull)
  reviewedById   String?
  reviewedBy     User?            @relation("TradeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  kind           ShiftTradeKind
  status         ShiftTradeStatus @default(OFFERED)
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([shiftId, status])
  @@index([claimantId, status])
}

model TimeEntry {
  id                    String          @id @default(cuid())
  organizationId        String
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId            String?
  location              Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  clockIn               DateTime
  clockOut              DateTime?
  breakStartedAt        DateTime?
  breakMinutes          Int             @default(0)
  approvalStatus        TimesheetStatus @default(PENDING)
  reviewedById          String?
  reviewedAt            DateTime?
  source                TimeEntrySource
  note                  String?
  correctionNote        String?
  correctionRequestedAt DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([organizationId, clockIn])
  @@index([userId, clockIn])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  OPEN
}

enum TimeOffType {
  VACATION
  SICK
  UNPAID
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ShiftTradeKind {
  OPEN_SHIFT
  SWAP
}

enum ShiftTradeStatus {
  OFFERED
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum TimeEntrySource {
  WEB
  MOBILE
  MANUAL
}

enum TimesheetStatus {
  PENDING
  APPROVED
  DECLINED
}
