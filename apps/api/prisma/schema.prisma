generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  locations Location[]
  positions Position[]
  shifts    Shift[]
}

model User {
  id             String @id @default(cuid())
  email          String @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  role           Role @default(EMPLOYEE)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  shifts         Shift[]
}

model Location {
  id             String @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  shifts         Shift[]
}

model Position {
  id             String @id @default(cuid())
  name           String
  color          String @default("#087f73")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  shifts         Shift[]
}

model Shift {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id])
  positionId     String
  position       Position    @relation(fields: [positionId], references: [id])
  assigneeId     String?
  assignee       User?       @relation(fields: [assigneeId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  unpaidBreakMin Int         @default(0)
  notes          String?
  status         ShiftStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId, startsAt])
  @@index([assigneeId, startsAt])
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  OPEN
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
}
